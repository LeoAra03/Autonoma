# Copia este archivo a .env y pega tus claves.
# Nunca subas .env a un repositorio público.

# Obligatoria. Créala en https://notrack.ai/api-keys
NOTRACK_API_KEY=sk-notrack-pega-aqui-tu-clave

# Opcional. Sin ella el agente busca en Brave vía Playwright o HTML.
# https://brave.com/search/api/
BRAVE_API_KEY=

# Opcionales
NOTRACK_BASE_URL=https://api.notrack.ai/v1
NOTRACK_MODEL=notrack-uncensored
# KNOWLEDGE_DIR=knowledge_base
# MAX_TOOL_ITERATIONS=14
