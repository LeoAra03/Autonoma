{
  "name": "generic",
  "editor": "textarea, div[contenteditable=\"true\"]",
  "sendButton": "button[type=\"submit\"], button[aria-label*=\"send\" i]",
  "busyButton": "button",
  "busyText": ["stop", "cancel", "working"],
  "continueCard": "button",
  "continueText": ["continue", "resume"],
  "captcha": ["iframe[src*=\"captcha\"]", "[class*=\"captcha\"]"],
  "verdict": {
    "state": "^\\s*[*_`]*ESTADO[*_`]*\\s*:?\\s*(verde|rojo|bloqueado)\\b",
    "evidence": "^\\s*[*_`]*EVIDENCIA[*_`]*\\s*:?\\s*(.+)$",
    "gates": "^\\s*[*_`]*GATES[*_`]*\\s*:?\\s*(.+)$",
    "done": "^\\s*[*_`]*HECHO[*_`]*\\s*:?\\s*(.+)$",
    "clean": "^\\s*[*_`>]*SIN HALLAZGOS[*_`]*\\s*$"
  },
  "requireEvidence": true
}
