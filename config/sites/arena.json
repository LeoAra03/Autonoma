{
  "name": "arena",
  "editor": "div[contenteditable=\"true\"], textarea",
  "sendButton": "button[aria-label*=\"send\" i], button[aria-label*=\"enviar\" i]",
  "busyButton": "button",
  "busyText": ["stop", "detener", "abort", "cancel"],
  "continueCard": "button, [role=\"button\"]",
  "continueText": ["continuar trabajando"],
  "captcha": ["iframe[src*=\"recaptcha\"]", "[class*=\"captcha\"]"],
  "verdict": {
    "state": "^\\s*[*_`]*ESTADO[*_`]*\\s*:?\\s*(verde|rojo|bloqueado)\\b",
    "evidence": "^\\s*[*_`]*EVIDENCIA[*_`]*\\s*:?\\s*(.+)$",
    "gates": "^\\s*[*_`]*GATES[*_`]*\\s*:?\\s*(.+)$",
    "done": "^\\s*[*_`]*HECHO[*_`]*\\s*:?\\s*(.+)$",
    "clean": "^\\s*[*_`>]*SIN HALLAZGOS[*_`]*\\s*$"
  },
  "requireEvidence": true
}
